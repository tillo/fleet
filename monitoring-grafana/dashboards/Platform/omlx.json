    {
      "id": 8,
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests / min",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(omlx_requests_total[5m])) * 60",
