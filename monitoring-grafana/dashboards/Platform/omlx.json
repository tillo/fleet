    {
      "id": 19,
      "type": "timeseries",
      "title": "Process memory vs pressure thresholds",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "max(omlx_memory_process_bytes)",
          "legendFormat": "process",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A"
