{
  "uid": "admission-control",
  "title": "Admission control — the policies actually evaluating",
  "tags": [
    "security",
    "admission",
    "policy-as-code",
    "mdapi"
  ],
  "editable": true,
  "links": [],
  "refresh": "5m",
  "schemaVersion": 36,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Policy as code, using Kubernetes' native admission rather than a third-party engine.** The rules are written in CEL as `ValidatingAdmissionPolicy`: no webhook to maintain, therefore no additional point of failure in the admission path. A third-party engine earns its keep when you need to *mutate* or *generate* resources — for example creating a NetworkPolicy on every namespace creation. Refusing what breaks a rule needs none of that.\n\n⭐ **These counters come from the API server itself, not from tooling.** That distinction matters: it is the component that actually decides, reporting its own decisions. A policy that is declared but never evaluated shows up here as silence."
      }
    },
    {
      "type": "stat",
      "title": "Admission policy checks",
      "description": "Evaluations performed by the CEL policies. Silence here means a policy is declared but never reached.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(apiserver_validating_admission_policy_check_total)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Pod Security denials — warn",
      "description": "Workloads that would have been refused under baseline. Warn reaches only the API client that made the call — which is why coverage is tracked separately.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(pod_security_evaluations_total{decision=\"deny\",mode=\"warn\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Pod Security denials — audit",
      "description": "Same evaluation, written to the audit log instead.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(pod_security_evaluations_total{decision=\"deny\",mode=\"audit\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Enforce-level admissions",
      "description": "⚠️ The cluster default is enforce=privileged: there is no blocking floor today. These labels produce signal, not refusal.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(pod_security_evaluations_total{mode=\"enforce\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Admission decisions, straight from the API server",
      "description": "Daily rhythm is normal: admission follows deployment activity. A flat zero on the denial lines after a rollout is worth a look — it usually means labels went missing, not that workloads improved.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (mode) (increase(pod_security_evaluations_total{decision=\"deny\"}[1h]))",
          "refId": "A",
          "legendFormat": "denied / hour — {{mode}}"
        },
        {
          "expr": "sum(increase(apiserver_validating_admission_policy_check_total[1h]))",
          "refId": "B",
          "legendFormat": "CEL policy checks / hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    }
  ]
}
