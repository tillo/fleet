    {
      "type": "timeseries",
      "title": "Snapshot and archive size — a collapse means an empty backup",
      "description": "Size is the cheapest integrity check there is: a snapshot that suddenly shrinks succeeded at writing nothing.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(openbao_raft_snapshot_bytes)",
          "refId": "A",
          "legendFormat": "raft snapshot bytes"
        },
        {
          "expr": "sum(openbao_secrets_archive_bytes)",
          "refId": "B",
          "legendFormat": "secrets archive bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
