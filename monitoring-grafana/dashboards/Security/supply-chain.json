        "w": 24,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(defectdojo_risk_acceptance_expiry_timestamp_seconds - time()) / 86400",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "defectdojo_risk_acceptance_findings",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "prometheus": true,
              "service": true,
              "instance": true,
              "namespace": true,
              "endpoint": true,
              "container": true,
              "pod": true
            },
            "renameByName": {
              "risk_acceptance": "Risk acceptance",
              "origin": "Origin",
              "product_type": "Product type",
              "product": "Product",
              "Value #A": "Days left",
              "Value #B": "Findings held"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Days left",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "product_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Risk acceptance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Accepted findings of this product in DefectDojo",
                    "url": "https://defectdojo.mdapi.ch/product/${__data.fields.product_id}/finding/accepted",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
