    {
      "type": "timeseries",
      "title": "Fixable vulnerabilities over time — rebuild cadence made visible",
      "description": "A sawtooth on the fixable lines is healthy: it means rebuilds land. A rising flat line means the daily patch layer has stopped reaching the registry. The third line is a different conversation entirely — nothing to rebuild, so it belongs in the risk register, not in a backlog.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(pod_image_cve_count{severity=\"critical\",fix_state=\"fixed\"})",
          "refId": "A",
          "legendFormat": "critical, fixable"
        },
        {
          "expr": "sum(pod_image_cve_count{severity=\"high\",fix_state=\"fixed\"})",
          "refId": "B",
          "legendFormat": "high, fixable"
        },
        {
          "expr": "sum(pod_image_cve_count{severity=\"critical\",fix_state=\"unfixed\"})",
          "refId": "C",
          "legendFormat": "critical, NO fix available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
