{
  "uid": "mdapi-overview",
  "title": "mdapi \u2014 Infrastructure Overview",
  "description": "Pinnable single-screen health overview. Green here means the fleet is fine; drill into the linked dashboards for detail.",
  "tags": [
    "overview",
    "mdapi"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 36,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 0,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "mdapi"
      ],
      "title": "All mdapi dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
