    {
      "id": 2,
      "type": "stat",
      "title": "Critical",
      "description": "Firing critical alerts. Anything above zero wants attention now.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
