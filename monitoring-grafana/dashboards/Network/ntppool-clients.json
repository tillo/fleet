{
 "uid": "ntppool-clients",
 "title": "NTP Pool Clients",
 "tags": [
  "ntppool",
  "probe"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "15m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "family",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "query": "label_values(ntppool_clients_total, family)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Distinct clients (last window)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "ntppool_clients_total",
     "legendFormat": "{{family}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "orientation": "horizontal"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Countries / AS seen",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "expr": "count(count by (country)(ntppool_clients_country))",
     "legendFormat": "countries",
     "refId": "A"
    },
    {
     "expr": "count(count by (asn)(ntppool_clients_as{asn!=\"other\"}))",
     "legendFormat": "AS (top-N tracked)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "orientation": "horizontal"
   }
  },
  {
   "id": 3,
   "type": "geomap",
   "title": "World heatmap \u2014 distinct clients by country",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 14,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (country) (ntppool_clients_country{family=~\"$family\"})",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-YlRd"
     },
     "unit": "short",
     "custom": {
      "hideFrom": {
       "tooltip": false,
       "viz": false,
       "legend": false
      }
     }
    },
    "overrides": []
   },
   "options": {
    "view": {
     "id": "zero",
     "lat": 22,
     "lon": 10,
     "zoom": 1.6
    },
    "basemap": {
     "type": "default",
     "name": "Basemap"
    },
    "controls": {
     "showZoom": true,
     "mouseWheelZoom": false,
     "showAttribution": true
    },
    "layers": [
     {
      "type": "markers",
      "name": "Clients",
      "location": {
       "mode": "lookup",
       "lookup": "country",
       "gazetteer": "public/gazetteer/countries.json"
      },
      "config": {
       "style": {
        "size": {
         "field": "Value",
         "min": 3,
         "max": 28
        },
        "color": {
         "field": "Value"
        },
        "opacity": 0.65
       },
       "showLegend": true
      },
      "tooltip": true
     }
    ],
    "tooltip": {
     "mode": "details"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Clients by country \u2014 timeline (top 12)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "expr": "topk(12, sum by (country) (ntppool_clients_country{family=~\"$family\"}))",
     "legendFormat": "{{country}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 35,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "showPoints": "never"
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Clients by provider (AS) \u2014 timeline (top 12)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "expr": "topk(12, sum by (as_name) (ntppool_clients_as{family=~\"$family\", asn!=\"other\"}))",
     "legendFormat": "{{as_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 35,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "showPoints": "never"
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "status-history",
   "title": "Country heat over time (top 15)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "expr": "topk(15, sum by (country) (ntppool_clients_country{family=~\"$family\"}))",
     "legendFormat": "{{country}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-GrYlRd"
     },
     "custom": {
      "lineWidth": 0,
      "fillOpacity": 85
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "rowHeight": 0.85,
    "colWidth": 0.92,
    "legend": {
     "displayMode": "hidden"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "maxDataPoints": 56,
   "description": "Bucket count capped at 56 (maxDataPoints) so the status-history point guard never trips, on any screen width or zoom. ~3h cells at 7d; sub-hour zooms repeat the last hourly value (VM scrapes the pushgateway continuously, so there are no gaps)."
  },
  {
   "id": 7,
   "type": "table",
   "title": "Top providers (AS)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "expr": "sort_desc(sum by (asn, as_name, family) (ntppool_clients_as{family=~\"$family\", asn!=\"other\"}))",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Value"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "clients"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "sortBy": [
     {
      "displayName": "clients",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ]
  }
 ],
 "version": 1
}