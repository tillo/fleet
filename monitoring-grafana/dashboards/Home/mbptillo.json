          "legendFormat": "system (battery-measured, discharging only)"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT TO_TIMESTAMP(s.last_updated_ts) AS time, s.state::float AS value FROM states s JOIN states_meta sm ON s.metadata_id = sm.metadata_id WHERE sm.entity_id = 'sensor.mbptillo_cpu_package_w' AND s.state ~ '^-?[0-9.]+$' AND $__timeFilter(TO_TIMESTAMP(s.last_updated_ts)) ORDER BY 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ha-postgres"
          },
          "legendFormat": "CPU package (RAPL)"
        }
      ],
      "description": "System draw is only measurable while DISCHARGING - while charging the brick supplies system+charge and BAT0 cannot split them, so gaps here are normal. 2026-08-08 tuning took it from 24-40 W to ~22-27 W (CPU package 17.6 -> 11.4 W)."
    },
