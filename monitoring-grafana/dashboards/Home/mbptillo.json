          "rawSql": "SELECT TO_TIMESTAMP(s.last_updated_ts) AS time, s.state::float AS value FROM states s JOIN states_meta sm ON s.metadata_id = sm.metadata_id WHERE sm.entity_id = 'sensor.mbptillo_power_draw_w' AND s.state ~ '^-?[0-9.]+$' AND $__timeFilter(TO_TIMESTAMP(s.last_updated_ts)) ORDER BY 1",
