  "annotations": {
    "list": [
      {
        "name": "AC lost",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ha-postgres"
        },
        "enable": true,
        "iconColor": "rgba(217, 83, 79, 1)",
        "rawQuery": true,
        "rawSql": "SELECT TO_TIMESTAMP(s.last_updated_ts) AS time, 'AC lost' AS text FROM states s JOIN states_meta sm ON s.metadata_id = sm.metadata_id WHERE sm.entity_id = 'sensor.mbptillo_ac_online' AND s.state = '0' AND $__timeFilter(TO_TIMESTAMP(s.last_updated_ts)) ORDER BY 1"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Battery",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ha-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT TO_TIMESTAMP(s.last_updated_ts) AS time, s.state::float AS value FROM states s JOIN states_meta sm ON s.metadata_id = sm.metadata_id WHERE sm.entity_id = 'sensor.mbptillo_battery_pct' AND s.state ~ '^-?[0-9.]+$' ORDER BY s.last_updated_ts DESC LIMIT 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ha-postgres"
          }
        }
      ]
    },
